<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrf_token %>">
    <title><%= page_title or "管理画面" %> - LuaAIDiary</title>
    <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <!-- ヘッダー -->
        <header class="admin-header">
            <div class="header-left">
                <button class="menu-toggle" id="menuToggle">☰</button>
                <h1 class="site-title">LuaAIDiary 管理画面</h1>
            </div>
            <div class="header-right">
                <% if user then %>
                    <div class="user-info">
                        <span class="user-icon">👤</span>
                        <a href="/admin/profile" class="username-link" title="プロフィールを表示">
                            <span class="username"><%= user.username or user.email %></span>
                        </a>
                    </div>
                    <form method="POST" action="/auth/logout" class="logout-form">
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <button type="submit" class="btn-logout">ログアウト</button>
                    </form>
                <% end %>
            </div>
        </header>

        <div class="admin-container">
            <!-- サイドバーナビゲーション -->
            <aside class="admin-sidebar" id="adminSidebar">
                <nav class="sidebar-nav">
                    <ul class="nav-menu">
                        <li class="nav-item">
                            <a href="/admin/dashboard" class="nav-link <%= active_menu == 'dashboard' and 'active' or '' %>">
                                <span class="nav-icon">📊</span>
                                <span class="nav-text">ダッシュボード</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/posts" class="nav-link <%= active_menu == 'posts' and 'active' or '' %>">
                                <span class="nav-icon">📝</span>
                                <span class="nav-text">投稿</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/posts/new" class="nav-link <%= active_menu == 'posts_new' and 'active' or '' %>">
                                <span class="nav-icon">➕</span>
                                <span class="nav-text">新規投稿</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/media" class="nav-link <%= active_menu == 'media' and 'active' or '' %>">
                                <span class="nav-icon">🖼️</span>
                                <span class="nav-text">メディア</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/categories" class="nav-link <%= active_menu == 'categories' and 'active' or '' %>">
                                <span class="nav-icon">📁</span>
                                <span class="nav-text">カテゴリー</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/tags" class="nav-link <%= active_menu == 'tags' and 'active' or '' %>">
                                <span class="nav-icon">🏷️</span>
                                <span class="nav-text">タグ</span>
                            </a>
                        </li>
                        <li class="nav-divider"></li>
                        <% if user and user.role == 'admin' then %>
                        <li class="nav-item">
                            <a href="/admin/users" class="nav-link <%= active_menu == 'users' and 'active' or '' %>">
                                <span class="nav-icon">👥</span>
                                <span class="nav-text">ユーザー管理</span>
                            </a>
                        </li>
                        <% end %>
                        <li class="nav-item">
                            <a href="/admin/profile" class="nav-link <%= active_menu == 'profile' and 'active' or '' %>">
                                <span class="nav-icon">👤</span>
                                <span class="nav-text">プロフィール</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/admin/settings" class="nav-link <%= active_menu == 'settings' and 'active' or '' %>">
                                <span class="nav-icon">⚙️</span>
                                <span class="nav-text">設定</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/" target="_blank" class="nav-link">
                                <span class="nav-icon">🌐</span>
                                <span class="nav-text">サイトを表示</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <!-- メインコンテンツエリア -->
            <main class="admin-main">
                <div class="content-wrapper">
                    <% if page_title then %>
                        <div class="page-header">
                            <h2 class="page-title"><%= page_title %></h2>
                            <% if page_actions then %>
                                <div class="page-actions">
                                    <%- page_actions %>
                                </div>
                            <% end %>
                        </div>
                    <% end %>

                    <!-- フラッシュメッセージ -->
                    <% if success_message then %>
                        <div class="alert alert-success">
                            <span class="alert-icon">✓</span>
                            <%= success_message %>
                        </div>
                    <% end %>
                    <% if error_message then %>
                        <div class="alert alert-error">
                            <span class="alert-icon">⚠</span>
                            <%= error_message %>
                        </div>
                    <% end %>

                    <!-- 子テンプレートの内容がここにレンダリングされる -->
                    <%- content_for_layout %>
                </div>
            </main>
        </div>

        <!-- フッター -->
        <footer class="admin-footer">
            <div class="footer-content">
                <p>&copy; <%= os.date("%Y") %> LuaAIDiary. All rights reserved.</p>
                <p class="footer-links">
                    <a href="https://github.com/hawkie275/LuaAIDiary/" target="_blank">GitHub</a>
                    <span class="separator">|</span>
                    <span class="version">Version <%= app_version or "Unknown" %></span>
                </p>
            </div>
        </footer>
    </div>

    <!-- 管理画面用JavaScript -->
    <script>
        // サイドバートグル
        document.addEventListener('DOMContentLoaded', function() {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('adminSidebar');
            const wrapper = document.querySelector('.admin-wrapper');

            if (menuToggle && sidebar) {
                menuToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('collapsed');
                    wrapper.classList.toggle('sidebar-collapsed');
                    
                    // ローカルストレージに状態を保存
                    const isCollapsed = sidebar.classList.contains('collapsed');
                    localStorage.setItem('sidebarCollapsed', isCollapsed);
                });

                // ページ読み込み時に前回の状態を復元
                const savedState = localStorage.getItem('sidebarCollapsed');
                if (savedState === 'true') {
                    sidebar.classList.add('collapsed');
                    wrapper.classList.add('sidebar-collapsed');
                }
            }

            // フラッシュメッセージの自動非表示
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    alert.style.opacity = '0';
                    setTimeout(function() {
                        alert.style.display = 'none';
                    }, 300);
                }, 5000);
            });
        });
    </script>
    <script src="/static/js/admin.js?v=<%= os.time() %>"></script>
    <style>
        .username-link {
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .username-link:hover {
            opacity: 0.8;
            text-decoration: underline;
        }
    </style>
</body>
</html>
